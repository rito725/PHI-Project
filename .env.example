# Backends. The defaults run fully offline on DuckDB.
WAREHOUSE_BACKEND=duckdb        # duckdb | bigquery
DLP_BACKEND=local               # local  | cloud
LLM_BACKEND=auto                # auto (claude if ANTHROPIC_API_KEY is set) | claude | offline

# Claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Google Cloud (only for WAREHOUSE_BACKEND=bigquery / DLP_BACKEND=cloud)
GCP_PROJECT=
BQ_LOCATION=US
GOOGLE_APPLICATION_CREDENTIALS=
# Least-privilege key for the analytics agent. See scripts/setup_gcp.sh.
ANALYST_CREDENTIALS_FILE=

# Guardrail limits
MAX_ROWS=1000
MAX_BYTES_BILLED=1000000000     # 1 GB
